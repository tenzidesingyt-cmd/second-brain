# Порт сервера (API + production-сборка)
PORT=8787

# Резервный пароль владельца. Нужен для входа без Telegram и для команды /owner в боте.
APP_PASSWORD=

# Необязательно: можно задать ключ здесь или вставить его в Настройках приложения.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_STT_MODEL=openai/whisper-1

# Каталог базы и загрузок. В Docker используется /app/data.
# DATA_DIR=./data

# Публичный HTTPS-адрес приложения: заголовок OpenRouter, ссылки в боте и webhook Telegram.
# PUBLIC_URL=https://brain.example.com

# Вход через Google. Redirect URI: <публичный адрес>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
OWNER_EMAIL=

# Telegram-бот: выдача логина и пароля новым пользователям.
# Токен получите у @BotFather. Не коммитьте его в git.
TELEGRAM_BOT_TOKEN=
# Необязательно: сохранить имя бота, если getMe недоступен.
TELEGRAM_BOT_USERNAME=
# Необязательно: Telegram ID владельца — этот аккаунт автоматически получит кабинет owner.
TELEGRAM_OWNER_ID=
# Необязательно: через запятую список Telegram ID, кому разрешена регистрация.
# Пусто — бот открыт для всех, кто знает его имя.
TELEGRAM_ALLOWED_IDS=
