# Порт сервера (API + production-сборка)
PORT=8787

# Необязательный пароль для входа. Если пусто — приложение открыто для локальной сети.
APP_PASSWORD=

# Необязательно: можно задать ключ здесь или вставить его в Настройках приложения.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_STT_MODEL=openai/whisper-1

# Каталог базы и загрузок. В Docker используется /app/data.
# DATA_DIR=./data

# Публичный адрес приложения для заголовка OpenRouter.
# PUBLIC_URL=https://brain.example.com

# Вход через Google. Redirect URI: <публичный адрес>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
OWNER_EMAIL=
